{
  "name": "datetime-stepper-card",
  "version": "0.2.2",
  "description": "Home Assistant Lovelace card to set a date and time with plus and minus buttons.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "esbuild src/datetime-stepper-card.ts --bundle --minify --format=esm --target=es2021 --outfile=dist/datetime-stepper-card.js",
    "watch": "esbuild src/datetime-stepper-card.ts --bundle --format=esm --target=es2021 --sourcemap --outfile=dist/datetime-stepper-card.js --watch",
    "typecheck": "tsc --noEmit",
    "harness": "esbuild src/datetime-stepper-card.ts --bundle --format=iife --target=es2021 --outfile=dev/datetime-stepper-card.iife.js"
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "hacs",
    "custom-card",
    "datetime",
    "input_datetime"
  ],
  "license": "MIT",
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
